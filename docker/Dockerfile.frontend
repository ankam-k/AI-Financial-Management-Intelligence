# syntax=docker/dockerfile:1
#
# The dashboard. Two stages: build the bundle with Node, serve it with nginx.
# The runtime image carries no Node and no node_modules — the output is 182 KB
# of static assets.

FROM node:22-alpine AS build

WORKDIR /build

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build


FROM nginx:1.27-alpine

# nginx also reverse-proxies /api to the backend, so the browser talks to one
# origin and the API needs no CORS configuration — the same arrangement the
# Vite dev proxy provides in development (ADR-017).
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /build/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=20s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1/ || exit 1
